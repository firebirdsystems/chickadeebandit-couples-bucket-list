{
  "id": "couples-bucket-list",
  "contexts": ["household", "shared_space"],
  "name": "Couple's Bucket List",
  "version": "1.0.0",
  "description": "A shared wishlist of experiences — travel, food, skills, milestones — that you want to do together.",
  "entrypoint": "index.html",
  "runtime": "static",
  "category": "couple",
  "tags": ["couples"],
  "data_access": {
    "reads": ["family.members"],
    "writes": []
  },
  "permissions": {
    "default_audience": "adults",
    "requires_approval": false
  },
  "storage": "db",
  "partner_link": {
    "table": "partner_config",
    "member_column": "member_id",
    "partner_id_column": "partner_id",
    "session_id_column": "session_id",
    "require_role": "adult"
  },
  "member_references": {
    "partner_config": [
      { "column": "member_id", "on_removed": "delete", "id_column": "rowid" },
      { "column": "partner_id", "on_removed": "delete", "id_column": "rowid" }
    ],
    "bucket_items": { "column": "created_by", "on_removed": "keep" }
  },
  "row_policies": {
    "partner_config": {
      "kind": "owner_only",
      "member_column": "member_id",
      "adults_bypass": false,
      "endpoint_writes_only": true
    },
    "bucket_items": {
      "kind": "couple_scoped",
      "self_column": "created_by",
      "participant_columns": ["created_by"],
      "partner_table": "partner_config",
      "partner_member_column": "member_id",
      "partner_id_column": "partner_id",
      "session_column": "session_id",
      "partner_session_id_column": "session_id",
      "require_reciprocal": true
    }
  },
  "file_acls": {
    "read": "couple_scoped"
  },
  "delete_file_columns": {
    "bucket_items": ["photo_id"]
  },
  "icon": "🪣",
  "glance": {
    "source": {
      "kind": "sql",
      "query": "SELECT COUNT(*) AS n FROM app_couples_bucket_list__bucket_items WHERE done_at IS NULL OR done_at = '' LIMIT 1"
    },
    "display": { "template": "badge", "count": "n", "label": "still to do together", "severity": "info" }
  },
  "nav": { "label": "Bucket List" },
  "kiosk": "never"
}
